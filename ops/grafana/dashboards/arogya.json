{
 "title": "Arogya claims",
 "uid": "arogya",
 "schemaVersion": 39,
 "refresh": "10s",
 "panels": [
  {
   "id": 1,
   "title": "Claims by outcome",
   "type": "bargauge",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "expr": "sum by (outcome) (arogya_claims_total)",
     "refId": "A",
     "legendFormat": "{{outcome}}",
     "instant": true,
     "range": false
    }
   ],
   "options": {
    "orientation": "horizontal",
    "displayMode": "gradient",
    "showUnfilled": true,
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   }
  },
  {
   "id": 2,
